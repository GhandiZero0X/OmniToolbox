FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-string
PORT=5000

# Batas upload
MAX_CONTENT_LENGTH_MB=200
MAX_FILES_PER_REQUEST=20
MAX_FILES_MERGE=100

# File sementara dihapus otomatis setelah sekian menit
FILE_RETENTION_MINUTES=60

# Jumlah proses paralel
IMAGE_WORKERS=4
PDF_WORKERS=2

# Path Ghostscript (kosongkan agar dicari otomatis)
# Windows: gswin64c   |   Linux/macOS: gs
GHOSTSCRIPT_PATH=gswin64c

# ----- Upscale foto (Real-ESRGAN) -----
# Pasang dulu dengan: python setup_realesrgan.py
# Kosongkan agar dicari otomatis di tools/realesrgan-ncnn-vulkan
REALESRGAN_PATH=tools
# RTX 3050 4GB: maksimal 2 agar tidak out-of-memory
UPSCALE_WORKERS=2
UPSCALE_TILE_SIZE=128
UPSCALE_GPU_ID=
UPSCALE_MAX_FILES=10
UPSCALE_MAX_INPUT_MP=30
UPSCALE_MAX_OUTPUT_MP=200
UPSCALE_MAX_QUEUE=30
UPSCALE_TIMEOUT_SECONDS=1000

# PDF -> Gambar: batas halaman per PDF (mencegah abuse)
PDF_RENDER_MAX_PAGES=100

# ----- Word -> PDF (via Microsoft Word + docx2pdf) -----
WORD_TIMEOUT_SECONDS=120
PDF_TO_WORD_MAX_PAGES=50

# ----- Konversi Video/Audio (FFmpeg) -----
# Kosongkan agar dicari otomatis di PATH (Windows: winget install Gyan.FFmpeg)
FFMPEG_PATH=
VIDEO_TIMEOUT_SECONDS=600
VIDEO_WORKERS=2