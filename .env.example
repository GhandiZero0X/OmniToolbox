FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-string
PORT=5000

# Batas upload
MAX_CONTENT_LENGTH_MB=200
MAX_FILES_PER_REQUEST=20
MAX_FILES_MERGE=100

# File sementara dihapus otomatis setelah sekian menit
FILE_RETENTION_MINUTES=60

# Jumlah proses paralel
IMAGE_WORKERS=4
PDF_WORKERS=2

# Path Ghostscript (kosongkan agar dicari otomatis)
# Windows: gswin64c   |   Linux/macOS: gs
GHOSTSCRIPT_PATH=gswin64c
